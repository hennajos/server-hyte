# Testing http requests with Visual Studio Code REST Client extension

###########################
## Users resource endpoints

### get all users
GET http://localhost:3000/api/users
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..2MC49rwu2B5Y4xfThOUxMxrhxAbrM9H4gZbBRkpk7eU

### get user by id
GET http://localhost:3000/api/users/3

### create a new user (user registration)
POST http://localhost:3000/api/users
content-type: application/json

{
  "username": "henu1",
  "password": "Salakala",
  "email": "henu1@example.com"
}

### modify an existing user by id
PUT http://localhost:3000/api/users/3
content-type: application/json

{
  "username": "editedname",
  "password": "editedpasswordx",
  "email": "editedmail@example.com"
}

### delete a user (by id)
DELETE http://localhost:3000/api/users/3

### user login
POST http://localhost:3000/api/auth/login
content-type: application/json

{
  "username": "henu1",
  "password": "Salakala"
}

### get my user info
GET http://localhost:3000/api/auth/me
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJ1c2VybmFtZSI6ImhlbnUxIiwiaWF0IjoxNzQyMDgzMTM3LCJleHAiOjE3NDIxNjk1Mzd9.mN9UJlNV-rtnlPnhRZQ6DR65VFUtbo6QQ-KWWs307pI

### post new entry
POST http://localhost:3000/api/entries
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJ1c2VybmFtZSI6ImhlbnUxIiwiaWF0IjoxNzQyMDgzMTM3LCJleHAiOjE3NDIxNjk1Mzd9.mN9UJlNV-rtnlPnhRZQ6DR65VFUtbo6QQ-KWWs307pI
content-type: application/json

{
"entry_date": "2025-02-13",
"mood": "happy",
"weight": 55,
"sleep_hours": 9,
"notes": "none",
"meal": "apple"
}

### Get user entries
GET http://localhost:3000/api/entries
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJ1c2VybmFtZSI6ImhlbnUxIiwiaWF0IjoxNzQyMDgzMTM3LCJleHAiOjE3NDIxNjk1Mzd9.mN9UJlNV-rtnlPnhRZQ6DR65VFUtbo6QQ-KWWs307pI
